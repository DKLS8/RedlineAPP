    {
      "parameters": {
        "jsCode": "// This code extracts the subject and body for each row based on step and variant\nconst sheetRow = $input.item.json;\nconst sequence = $('Extract Campaign Sequence').item.json.sequence;\n\nif (!sequence || !sequence.steps) {\n  return { json: sheetRow };\n}\n\n// Get step number (convert from string, 0-indexed)\nconst stepIndex = parseInt(sheetRow.Step);\nconst variantIndex = parseInt(sheetRow.Variant);\n\n// Get the step and variant\nconst step = sequence.steps[stepIndex];\nif (!step || !step.variants) {\n  return { json: sheetRow };\n}\n\nconst variant = step.variants[variantIndex];\nif (!variant) {\n  return { json: sheetRow };\n}\n\n// Extract subject and body\nconst subject = variant.subject || '';\nconst body = variant.body || '';\n\n// Convert HTML to plain text (basic conversion)\nconst plainTextBody = body\n  .replace(/<br\\s*\\/?>/gi, '\\n')\n  .replace(/<div[^>]*>/gi, '')\n  .replace(/<\\/div>/gi, '\\n')\n  .replace(/<[^>]+>/g, '')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&amp;/g, '&')\n  .trim();\n\nreturn {\n  json: {\n    ...sheetRow,\n    Subject: subject,\n    Body: plainTextBody,\n    rowNumber: $input.item.json.row_number\n  }\n};"
      },
