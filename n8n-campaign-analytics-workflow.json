      "id": "read-sheet-rows",
      "name": "Read Google Sheets Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [460, 580],
      "credentials": {
        "googleSheetsOAuth2Api": {
