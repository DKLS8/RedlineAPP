    {
      "parameters": {
        "jsCode": "// Extract campaigns from response\nconst campaigns = $input.item.json.data?.items || [];\n\nif (campaigns.length === 0) {\n  return [];\n}\n\n// Get the first campaign (should match search)\nconst campaign = campaigns[0];\nconst sequence = campaign.sequences?.[0];\n\nif (!sequence || !sequence.steps) {\n  return [];\n}\n\n// Store sequence data for later use\nreturn [{ \n  json: {\n    campaign_id: campaign.id,\n    campaign_name: campaign.name,\n    sequence: sequence\n  }\n}];"
      },
