# ========================================
# n8n Environment Variables Template
# ========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive API keys!

# ========================================
# GOOGLE WORKSPACE
# ========================================

# Your Google Sheet ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/1a2b3c4d5e6f7g8h9i/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# Google Service Account Email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com


# ========================================
# OPENAI
# ========================================

# OpenAI API Key (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-...


# ========================================
# APIFY
# ========================================

# Apify API Token (get from: https://console.apify.com/account/integrations)
APIFY_API_KEY=apify_api_...

# LinkedIn Jobs Scraper Actor ID
# Find at: https://apify.com/actors/linkedin-jobs-scraper
# Example: apify/linkedin-jobs-scraper or custom actor ID
APIFY_LINKEDIN_SCRAPER_ID=apify/linkedin-jobs-scraper


# ========================================
# LEADMAGIC
# ========================================

# LeadMagic API Key (get from: https://app.leadmagic.io/settings/api)
LEADMAGIC_API_KEY=lm_...


# ========================================
# INSTANTLY.AI
# ========================================

# Instantly.ai API Key (get from: https://app.instantly.ai/app/settings/integrations)
INSTANTLY_API_KEY=...

# Instantly.ai Campaign ID
# Create a campaign first, then get ID from URL: https://app.instantly.ai/app/campaigns/[CAMPAIGN_ID]
INSTANTLY_CAMPAIGN_ID=...


# ========================================
# HEYREACH
# ========================================

# HeyReach API Key (get from: https://app.heyreach.io/settings/api)
HEYREACH_API_KEY=...

# HeyReach Campaign ID
# Create a LinkedIn campaign first, then copy ID from campaign settings
HEYREACH_CAMPAIGN_ID=...


# ========================================
# SLACK NOTIFICATIONS
# ========================================

# Slack Channel (where to send notifications)
# Example: #recruitment-alerts or #job-matching
SLACK_CHANNEL=#recruitment-alerts

# Slack Webhook URL (create at: https://api.slack.com/messaging/webhooks)
# OR use Bot Token if using OAuth
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...


# ========================================
# EMAIL NOTIFICATIONS
# ========================================

# Email address to send notifications FROM
NOTIFICATION_EMAIL_FROM=noreply@yourcompany.com

# Email address to send notifications TO
NOTIFICATION_EMAIL_TO=your@email.com

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password_here


# ========================================
# OPTIONAL CONFIGURATION
# ========================================

# Daily outreach limit (safety feature to prevent over-sending)
# DAILY_OUTREACH_LIMIT=50

# Enable debug mode (more verbose logging)
# DEBUG_MODE=false

# Workflow timezone (for schedule trigger)
# TIMEZONE=America/New_York


# ========================================
# NOTES
# ========================================
#
# 1. NEVER commit this file to git with real values
# 2. Add .env to .gitignore
# 3. Rotate API keys quarterly for security
# 4. Test all credentials before production use
# 5. Monitor API usage and costs regularly
#
# For detailed setup instructions, see SETUP_GUIDE.md
# ========================================
